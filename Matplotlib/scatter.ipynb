   "source": [
    "study_hours = [1, 2, 3, 4, 5]\n",
    "marks = [40, 50, 60, 70, 85]\n",
    "\n",
    "plt.scatter(study_hours, marks, marker='o', s=5, alpha=0.6)\n",
    "\n",
    "plt.xlabel(\"Study Hours\")\n",
    "plt.ylabel(\"Marks\")\n",
    "plt.title(\"Study Hours vs Marks\")\n",
    "plt.show()"
   ]
